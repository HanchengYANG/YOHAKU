{
  "name": "yohaku-reader",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "余白 · 多语阅读与笔记",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:https": "node scripts/dev.mjs --https",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:browser:ai": "npm run build && playwright test -c playwright.ai.config.mjs",
    "verify:ai": "node scripts/verify-ai.mjs",
    "check": "npm run test && npm run build",
    "verify:stage3": "node scripts/verify-stage3.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
