# Copy to deploy/instances/<name>.env, then edit on the target server.
# This is a trusted shell-assignment file. Use absolute paths; do not add commands.
APP_USER=appuser
APP_DIR=/home/appuser/yohaku

GIT_REMOTE=origin
GIT_BRANCH=main
# Optional. Empty keeps the repository's existing SSH configuration.
DEPLOY_KEY=/home/appuser/.ssh/yohaku_deploy

# Browser-facing origins, including any external port. No paths or trailing slash.
PUBLIC_ORIGIN=https://reader.example
PUBLIC_ORIGINS=

# Server-side listeners; these can differ from a router's external port.
PORT=4317
HTTPS_PORT=443
# Empty uses APP_DIR/data. Existing data is never moved automatically.
DATA_DIR=

# local-ca: generate a private CA and a separate server certificate from the
# configured origins. self-signed: one certificate. existing: never generate.
# Existing pairs are kept and validated. Renew explicitly with pi-certificates.sh
# --renew after changing origins; local-ca preserves the root trusted by phones.
TLS_MODE=local-ca
TLS_CERT=/etc/nginx/yohaku/tls.crt
TLS_KEY=/etc/nginx/yohaku/tls.key
TLS_CA_CERT=/etc/nginx/yohaku/ca.crt
TLS_CA_KEY=/etc/nginx/yohaku/ca.key
TLS_CERT_DAYS=365
TLS_CA_DAYS=3650
# HTTP request deadline for account fixtures during deployment tests; the
# application timeouts and password hashing parameters are unchanged.
DEPLOY_TEST_HTTP_TIMEOUT_MS=30000
# In existing mode, TLS_CA_CERT may be empty for a publicly trusted certificate;
# no root download is then advertised. TLS_CA_KEY is only used in local-ca mode.
