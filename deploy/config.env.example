# Copy to deploy/instances/<name>.env, then edit on the target server.
# This is a trusted shell-assignment file. Use absolute paths; do not add commands.
APP_USER=appuser
APP_DIR=/home/appuser/yohaku

GIT_REMOTE=origin
GIT_BRANCH=main
# Optional. Empty keeps the repository's existing SSH configuration.
DEPLOY_KEY=/home/appuser/.ssh/yohaku_deploy

# Browser-facing origins, including any external port. No paths or trailing slash.
PUBLIC_ORIGIN=https://reader.example
PUBLIC_ORIGINS=

# Server-side listeners; these can differ from a router's external port.
PORT=4317
HTTPS_PORT=443
# Empty uses APP_DIR/data. Existing data is never moved automatically.
DATA_DIR=

# Existing certificates are reused. If both files are absent, setup creates a
# self-signed certificate. Keep actual keys and certificates outside Git.
TLS_CERT=/etc/nginx/yohaku/tls.crt
TLS_KEY=/etc/nginx/yohaku/tls.key
