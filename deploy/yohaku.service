[Unit]
Description=YOHAKU Japanese reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_ROOT@
Environment=NODE_ENV=production
Environment=HOME=@APP_HOME@
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
Environment=YOHAKU_CODEX_PATH=@APP_HOME@/.local/share/yohaku/codex/bin/codex
EnvironmentFile=/etc/yohaku/runtime.env
ExecStart=@NODE_BIN@/node server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
