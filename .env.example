# Copy to .env and adjust for this machine; .env is ignored by Git.
# scripts/dev.mjs loads it, so `npm run dev` needs no extra variables.
# Variables given on the command line take precedence over this file.
#
# Quickest way to start LAN HTTPS development (auto-detects IP and generates
# the certificate if missing):
#   npm run dev:https
#
# Or uncomment the LAN block below so plain `npm run dev` always uses HTTPS.

# IP or name the dev server binds to (`lan` auto-detects the LAN IPv4 address).
HOST=127.0.0.1

# --- LAN / HTTPS ---------------------------------------------------------
# HOST=lan
# Developer certificate (auto-generated by scripts/dev-tls.sh when missing or
# when the LAN IP changes). '~' expands to the home directory.
# TLS_CERT=~/.local/share/yohaku/dev/cert.pem
# TLS_KEY=~/.local/share/yohaku/dev/key.pem
# Browser-facing origin; defaults to https://<HOST>:5173 when left unset.
# PUBLIC_ORIGIN=https://192.168.1.50:5173

# Optional additional origins, comma-separated.
# PUBLIC_ORIGINS=

# API port the server listens on (default 4317).
# PORT=4317
